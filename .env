# ============================================================
# .env — Variables d'environnement PayMyBuddy
# ⚠️  NE PAS committer ce fichier dans Git !
#     Ajouter .env dans le .gitignore
# ============================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=db_paymybuddy
MYSQL_USER=paymybuddy
MYSQL_PASSWORD=paymybuddy

# --- Spring Boot Datasource ---
SPRING_DATASOURCE_URL=jdbc:mysql://paymybuddy-db:3306/db_paymybuddy?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=paymybuddy
SPRING_DATASOURCE_PASSWORD=paymybuddy

# --- Hibernate ---
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
